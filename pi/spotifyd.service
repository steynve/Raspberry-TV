# Spotify Connect for the TV: the Pi shows up as "Raspberry" in the Spotify app.
# Installed in /etc/systemd/system/ by setup.sh. Runs as pipi, in the kiosk's PulseAudio.
[Unit]
Description=Spotify Connect (spotifyd)
Wants=network-online.target
After=network-online.target sound.target

[Service]
User=pipi
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/local/bin/spotifyd --no-daemon \
    --device-name Raspberry \
    --device-type tv \
    --backend pulseaudio \
    --bitrate 320 \
    --volume-controller soft-volume \
    --initial-volume 50 \
    --volume-normalisation \
    --use-mpris \
    --dbus-type session \
    --on-song-change-hook /usr/local/bin/raspberry-spotify \
    --cache-path /home/pipi/.cache/spotifyd \
    --no-audio-cache
# The kiosk's PulseAudio and D-Bus start with its login, so keep trying until they're there
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
