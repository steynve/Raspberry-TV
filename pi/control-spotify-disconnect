#!/bin/sh
# POST /control/spotify-disconnect: the TV app lets go of the phone when the TV turns off or
# switches away. Only the Pi itself may call it, see lighttpd.conf.
# Installed in /usr/local/lib/raspberry/control/ by setup.sh.
printf 'Content-Type: text/plain\r\n\r\n'
sudo -n -u pipi /usr/local/bin/raspberry-spotify-disconnect > /dev/null 2>&1 && echo disconnected || echo "nothing to disconnect"
