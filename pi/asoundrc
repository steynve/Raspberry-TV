# Sends all sound to the HDMI output, by its name: card numbers change between OS versions.
# Installed as ~/.asoundrc by setup.sh.
pcm.!default {
  type asym
  playback.pcm {
    type plug
    slave.pcm "output"
  }
  capture.pcm {
    type plug
    slave.pcm "input"
  }
}

pcm.output {
  type hw
  card vc4hdmi
}

ctl.!default {
  type hw
  card vc4hdmi
}
